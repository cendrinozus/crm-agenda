# Flask
# development → debug activé (local uniquement)
# production  → debug désactivé, erreurs non exposées (VPS)
FLASK_ENV=development
FLASK_SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=True  # Mettre False en production

# MySQL
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/crm_agenda
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=crm_agenda
MYSQL_USER=root
MYSQL_PASSWORD=password

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
GOOGLE_SCOPES=openid email profile https://www.googleapis.com/auth/calendar.readonly

# AI Services
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Transcription: whisper | google
TRANSCRIPTION_PROVIDER=whisper

# Google Speech-to-Text (alternative)
GOOGLE_SPEECH_CREDENTIALS_PATH=./google-speech-credentials.json

# File Storage
UPLOAD_FOLDER=./uploads/audio
MAX_CONTENT_LENGTH=52428800

# Redis (for Celery tasks)
REDIS_URL=redis://localhost:6379/0

# Encryption
ENCRYPTION_KEY=your-fernet-encryption-key-32bytes

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000
